# Copy to .env.local. Both values are in Supabase: Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile site key, to put CAPTCHA on sign-in
VITE_TURNSTILE_SITE_KEY=
# Optional: on, once a GitHub OAuth app is enabled under Supabase Auth > Providers > GitHub
VITE_GITHUB_SIGNIN=
